rules_version = '2';

// ===============================================================
// Berlin-Nukus — Firestore Security Rules (PROTOTIP)
// ===============================================================
//
// DIQQAT: Bu rules prototip sifatida yozilgan. Asosiy maqsad —
// autentifikatsiyani talab qilish va yozuvlarni egasi/roli bo'yicha
// cheklash. Commercial launch'dan oldin albatta qayta ko'rib chiqing.
//
// Taxmin qilingan ma'lumot modeli:
//
// Collection: users/{uid}
//   - uid: string (hujjat ID bilan bir xil)
//   - fullName: string
//   - email: string (PII)
//   - phone: string (PII)
//   - role: 'student' | 'teacher' | 'admin'
//   - avatarUrl: string
//   - currentStreak, totalStars, averageScore, dailyMinutesMap, ...
//
// Collection: groups/{groupId}
//   - teacherId: string, students: [uid], courseId, name, ...
//   - subcollection: messages/{messageId}
//
// Collection: courses/{courseId}
// Collection: darslar/{groupId_dateKey}
// Collection: payments/{paymentId}  (studentId, groupId, ...)
// Collection: notifications/{id}    (userId, ...)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper funksiyalar ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Joriy foydalanuvchining roli (users hujjatidan o'qiladi)
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userRole() == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userRole() == 'teacher';
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Yaratish: o'z hujjatini FAQAT 'student' roli bilan yaratadi
      allow create: if isAdmin() ||
        (isOwner(userId) && request.resource.data.role == 'student');

      // Yangilash: egasi o'z hujjatini yangilay oladi, lekin ROLNI o'zgartira olmaydi
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         ((!('role' in resource.data) && request.resource.data.role == 'student') ||
          (('role' in resource.data) && request.resource.data.role == resource.data.role)));

      // O'chirish: faqat admin
      allow delete: if isAdmin();

      // Subkolleksiyalar (results, mock_test_history, va b.)
      match /{subPath=**} {
        allow read: if isOwner(userId) || isTeacher() || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // ── groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();

      // Guruh ichidagi xabarlar
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          (resource.data.senderId == request.auth.uid || isTeacher() || isAdmin());
      }
    }

    // ── courses ─────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // ── darslar (lessons) ───────────────────────────────────────────────────
    // O'qish: barcha a'zolar. Yozish: o'qituvchi/admin.
    // Talabalar esa FAQAT o'zlarining uyga vazifa topshirig'ini (homeworkSubmissions.[myUid]) update qila oladi.
    match /darslar/{lessonId} {
      allow read: if isAuthenticated();
      allow create, delete: if isTeacher() || isAdmin();
      allow update: if isTeacher() || isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeworkSubmissions']) &&
         (!('homeworkSubmissions' in resource.data) ||
          request.resource.data.homeworkSubmissions.diff(resource.data.homeworkSubmissions).affectedKeys().hasOnly([request.auth.uid])));
    }

    // ── payments ──────────────────────────────────────────────────────────────
    // O'qish: talaba FAQAT o'zinikini, admin esa hammasini ko'radi.
    // (Avval har bir autentifikatsiyalangan foydalanuvchi hammasini o'qiy
    //  olardi — bu moliyaviy ma'lumot oshkorligi edi.)
    // Yaratish: talaba o'ziga, o'qituvchi/admin istalganiga.
    // O'zgartirish/o'chirish: faqat admin.
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || isTeacher() ||
        (isAuthenticated() &&
         request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Foydalanuvchi faqat o'ziga tegishli bildirishnomalarni boshqaradi.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ── Default: hamma narsa taqiqlangan ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
